# ==================== HOMELAB ENVIRONMENT VARIABLES / ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ====================

# Paths to data storage / Пути к хранилищам данных
HDD1_PATH=/mnt/hdd1/docker  # HDD1: Books, Kiwix, downloads / Книги, Kiwix, загрузки
HDD2_PATH=/mnt/hdd2/docker  # HDD2: Maps, Trilium, Kanboard, FileBrowser / Карты, Trilium, Kanboard, FileBrowser

# Server network settings / Сетевые настройки сервера
SERVER_IP=192.168.1.46      # Local network IP / IP в локальной сети
SERVER_PORT=24              # Main entry port / Основной порт входа

# Proxy settings (if needed) / Настройки прокси (если требуется)
HTTP_PROXY=
HTTPS_PROXY=

# UID/GID for container permissions / UID/GID для прав контейнеров
USER_UID=1000               # Host user ID / ID пользователя на хосте
USER_GID=1000               # Host group ID / ID группы на хосте
