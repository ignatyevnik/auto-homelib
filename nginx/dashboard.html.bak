<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeLab • 192.168.1.46</title>
    <!-- Карты (Локально) -->
    <link rel="stylesheet" href="/maplibre-gl.css">
    <script src="/maplibre-gl.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Courier New', 'Times New Roman', monospace;
            background: #080a0f;
            background-image: 
                repeating-linear-gradient(0deg, #0a0f0a 0px, #0a0f0a 2px, transparent 2px, transparent 6px),
                repeating-linear-gradient(90deg, #0a0f0a 0px, #0a0f0a 2px, transparent 2px, transparent 6px),
                radial-gradient(circle at 30% 40%, #1a2a1a 0%, #080a0f 90%);
            color: #a0c0a0;
            padding: 20px;
            min-height: 100vh;
            animation: warpStorm 4s ease-in-out infinite;
        }

        @keyframes warpStorm {
            0%, 100% { 
                background-color: #080a0f;
                box-shadow: 
                    inset 0 0 50px rgba(26, 58, 26, 0.3),
                    inset 0 0 100px rgba(0, 0, 0, 0.8);
            }
            20% {
                background-color: #0a150a;
                box-shadow: 
                    inset 0 0 80px rgba(42, 100, 42, 0.6),
                    inset 0 0 150px rgba(0, 0, 0, 0.6);
            }
            40% {
                background-color: #0c1a0c;
                box-shadow: 
                    inset 0 0 120px rgba(58, 150, 58, 0.5),
                    inset 0 0 200px rgba(0, 0, 0, 0.4);
            }
            60% {
                background-color: #0d1a0d;
                box-shadow: 
                    inset 0 0 150px rgba(74, 180, 74, 0.4),
                    inset 0 0 250px rgba(0, 0, 0, 0.3);
            }
            80% {
                background-color: #0a150a;
                box-shadow: 
                    inset 0 0 100px rgba(42, 100, 42, 0.6),
                    inset 0 0 180px rgba(0, 0, 0, 0.5);
            }
        }
        
        .container { max-width: 1400px; margin: 0 auto; }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding: 20px 30px;
            background: #0a0e0a;
            border: 2px solid #2a4a2a;
            box-shadow: 
                0 0 30px rgba(42, 74, 42, 0.4),
                inset 0 0 40px rgba(0, 0, 0, 0.9);
            position: relative;
        }
        .header::before {
            content: "⚙☠⚙";
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: #0a0e0a;
            padding: 0 15px;
            color: #3a6a3a;
            font-size: 16px;
            letter-spacing: 8px;
            text-shadow: 0 0 10px #3a6a3a;
        }
        h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2a5a2a;
            text-shadow: 
                0 0 20px #1a3a1a,
                2px 2px 0 #0a1a0a;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-family: 'Courier New', monospace;
            transform: skewX(-5deg);
            white-space: nowrap;
        }
        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .lang-switch {
            display: flex;
            gap: 3px;
        }
        .lang-btn {
            background: #0a120a;
            border: 1px solid #2a4a2a;
            color: #4a7a4a;
            padding: 8px 16px;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.2s;
            transform: skewX(-5deg);
        }
        .lang-btn:hover {
            background: #1a2a1a;
            border-color: #3a7a3a;
            color: #6aaa6a;
            box-shadow: 0 0 15px #2a5a2a;
        }
        .lang-btn.active {
            background: #1a3a1a;
            border-color: #4a9a4a;
            color: #8aca8a;
            box-shadow: 0 0 20px #3a7a3a, inset 0 0 10px #1a3a1a;
        }
        .server-ip {
            color: #4a8a4a;
            font-family: 'Courier New', monospace;
            font-size: 1.2rem;
            font-weight: bold;
            background: #0a120a;
            padding: 10px 20px;
            border: 1px solid #2a5a2a;
            letter-spacing: 3px;
            box-shadow: inset 0 0 15px #0a0a0a, 0 0 10px #2a4a2a;
            transform: skewX(-5deg);
        }
        
        .grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        
        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 20px;
        }
        
        .card {
            background: #0a0e0a;
            border: 1px solid #2a4a2a;
            padding: 20px;
            box-shadow: 
                0 0 30px rgba(0, 0, 0, 0.8),
                inset 0 0 30px rgba(26, 58, 26, 0.1);
            position: relative;
        }
        .card::after {
            content: "⚙";
            position: absolute;
            bottom: 5px;
            right: 10px;
            font-size: 20px;
            color: #2a4a2a;
            opacity: 0.3;
            transform: rotate(15deg);
        }
        .card-title {
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 18px;
            color: #4a8a4a;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-family: 'Courier New', monospace;
            border-bottom: 1px solid #2a4a2a;
            padding-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            transform: skewX(-3deg);
        }
        
        .metric {
            margin-bottom: 16px;
        }
        .metric-header {
            display: flex;
            justify-content: space-between;
            color: #5a8a5a;
            font-size: 0.85rem;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .metric-value {
            color: #8aba8a;
            font-weight: bold;
            font-family: 'Courier New', monospace;
        }
        .progress-bar {
            height: 6px;
            background: #0a120a;
            border: 1px solid #1a3a1a;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #2a5a2a, #4a9a4a, #2a5a2a);
            transition: width 0.3s;
        }
        .progress-fill.warning { background: linear-gradient(90deg, #5a5a2a, #9a9a4a, #5a5a2a); }
        .progress-fill.critical { background: linear-gradient(90deg, #5a2a2a, #9a4a4a, #5a2a2a); }
        
        .sysinfo-row {
            display: flex;
            flex-wrap: wrap;
            gap: 15px 30px;
            padding: 12px 0;
            margin-bottom: 12px;
            border-bottom: 1px solid #1a3a1a;
        }
        .sysinfo-item {
            display: flex;
            align-items: baseline;
            gap: 8px;
            font-size: 0.9rem;
        }
        .sysinfo-label { 
            color: #4a7a4a; 
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .sysinfo-value {
            color: #8aba8a;
            font-weight: bold;
            font-family: 'Courier New', monospace;
        }
        
        .service-card {
            background: #0a0e0a;
            border: 1px solid #2a4a2a;
            padding: 18px;
            text-decoration: none;
            color: #a0c0a0;
            transition: all 0.2s;
            display: block;
            position: relative;
        }
        .service-card:hover {
            border-color: #4a8a4a;
            transform: translateY(-3px);
            background: #0a120a;
            box-shadow: 
                0 10px 20px rgba(0, 0, 0, 0.8),
                0 0 30px rgba(42, 74, 42, 0.3);
        }
        .service-card::before {
            content: "☠";
            position: absolute;
            top: 5px;
            right: 10px;
            font-size: 14px;
            color: #2a4a2a;
            opacity: 0.4;
        }
        .service-icon {
            font-size: 2rem;
            margin-bottom: 12px;
            filter: drop-shadow(0 0 5px #2a5a2a);
        }
        .service-name {
            font-weight: bold;
            font-size: 1.1rem;
            margin-bottom: 6px;
            color: #4a8a4a;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-family: 'Courier New', monospace;
        }
        .service-port {
            font-size: 0.8rem;
            color: #5a8a5a;
            font-family: 'Courier New', monospace;
        }
        .service-note {
            font-size: 0.7rem;
            color: #4a6a4a;
            margin-top: 10px;
            font-style: italic;
        }
        
        .formats {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 10px;
        }
        .format-tag {
            background: #0a120a;
            border: 1px solid #2a4a2a;
            color: #5a8a5a;
            font-size: 0.6rem;
            padding: 3px 8px;
            font-family: 'Courier New', monospace;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .status-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 0;
        }
        .status-dot {
            width: 12px;
            height: 12px;
            background: #3a7a3a;
            border: 1px solid #2a5a2a;
            box-shadow: 0 0 10px #3a7a3a;
            flex-shrink: 0;
            transform: rotate(45deg);
        }
        .status-dot.offline { 
            background: #5a2a2a; 
            box-shadow: 0 0 10px #5a2a2a;
        }
        
        .footer {
            text-align: center;
            margin-top: 30px;
            padding: 20px;
            color: #4a6a4a;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            border-top: 1px solid #2a4a2a;
            font-family: 'Courier New', monospace;
        }
        
        .refresh-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-left: auto;
            font-size: 0.7rem;
            color: #5a8a5a;
        }
        .refresh-dot {
            width: 8px;
            height: 8px;
            background: #4a8a4a;
            box-shadow: 0 0 10px #4a8a4a;
            animation: pulse 2s infinite;
            transform: rotate(45deg);
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        
        .map-card {
            grid-column: 1 / -1;
            padding: 0;
            overflow: hidden;
            border: 1px solid #2a4a2a;
            transition: opacity 0.3s ease;
        }
        .map-container {
            width: 100%;
            height: 400px;
        }
        .map-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            border-bottom: 1px solid #2a4a2a;
            background: #0a0e0a;
        }
        
        .hardware-detail {
            font-size: 0.75rem;
            color: #5a8a5a;
            margin-top: 6px;
            line-height: 1.5;
            font-family: 'Courier New', monospace;
        }
        
        .chaos-star {
            font-size: 1.5rem;
            color: #4a8a4a;
            text-shadow: 0 0 15px #3a7a3a;
        }
        
        @media (max-width: 1000px) {
            .services-grid { grid-template-columns: repeat(3, 1fr); }
        }
        @media (max-width: 800px) {
            .grid { grid-template-columns: 1fr; }
            .services-grid { grid-template-columns: repeat(2, 1fr); }
            .header { flex-direction: column; gap: 15px; }
            h1 { 
                font-size: 1.4rem; 
                letter-spacing: 2px; 
                white-space: nowrap; 
            }
        }
        @media (max-width: 500px) {
            .services-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 550px) {
            h1 { 
                font-size: 1.1rem; 
                letter-spacing: 1px; 
                white-space: nowrap; 
            }
            .header { padding: 15px; }
            .server-ip { font-size: 0.9rem; padding: 5px 10px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>☠ <span data-i18n="title">STANDARD TEMPLATE CONSTRUCT</span> ☠</h1>
            <div class="header-right">
                <div class="lang-switch">
                    <button class="lang-btn active" data-lang="ru">RU</button>
                    <button class="lang-btn" data-lang="en">EN</button>
                </div>
                <div class="server-ip">192.168.1.46</div>
            </div>
        </div>
        
        <div class="grid">
            <!-- Система -->
            <div class="card">
                <div class="card-title">
                    <span class="chaos-star">⚙</span> 
                    <span data-i18n="system">СИСТЕМА</span>
                    <span class="refresh-badge">
                        <span class="refresh-dot"></span>
                        <span id="update-time">live</span>
                    </span>
                </div>
                
                <div class="sysinfo-row">
                    <div class="sysinfo-item"><span class="sysinfo-label" data-i18n="os">ОС</span> <span class="sysinfo-value" id="os-name">—</span></div>
                    <div class="sysinfo-item"><span class="sysinfo-label" data-i18n="uptime">АПТАЙМ</span> <span class="sysinfo-value" id="uptime">—</span></div>
                </div>
                
                <!-- CPU -->
                <div class="metric">
                    <div class="metric-header">
                        <span>☠ CPU</span>
                        <span class="metric-value" id="cpu-usage">—%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" id="cpu-bar" style="width: 0%"></div>
                    </div>
                    <div class="hardware-detail">
                        <span id="cpu-model">—</span><br>
                        <span id="cpu-cores">—</span> • <span id="cpu-temp">—</span>
                    </div>
                </div>
                
                <!-- GPU -->
                <div class="metric">
                    <div class="metric-header">
                        <span>⚡ GPU</span>
                        <span class="metric-value" id="gpu-mem">—</span>
                    </div>
                    <div class="hardware-detail">
                        <span id="gpu-name">—</span><br>
                        <span id="gpu-freq">—</span> • <span id="gpu-temp">—</span>
                    </div>
                </div>
                
                <!-- RAM -->
                <div class="metric">
                    <div class="metric-header">
                        <span>📀 RAM</span>
                        <span class="metric-value" id="ram-usage">— / —</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" id="ram-bar" style="width: 0%"></div>
                    </div>
                </div>
                
                <!-- Load -->
                <div class="metric">
                    <div class="metric-header">
                        <span>⏳ LOAD</span>
                        <span class="metric-value" id="load-avg">—</span>
                    </div>
                </div>
            </div>
            
            <!-- Статус сервисов -->
            <div class="card">
                <div class="card-title">
                    <span class="chaos-star">☠</span>
                    <span data-i18n="status">СТАТУС СЕРВИСОВ</span>
                </div>
                <div id="status-container">
                    <div class="status-row"><span class="status-dot" id="status-nginx"></span><span>Nginx (:24)</span></div>
                    <div class="status-row"><span class="status-dot" id="status-kanboard"></span><span>Kanboard (:8081)</span></div>
                    <div class="status-row"><span class="status-dot" id="status-filebrowser"></span><span>FileBrowser (:8082)</span></div>
                    <div class="status-row"><span class="status-dot" id="status-calibre"></span><span>Calibre-Web (:8083)</span></div>
                    <div class="status-row"><span class="status-dot" id="status-kiwix"></span><span>Kiwix (:8084)</span></div>
                    <div class="status-row"><span class="status-dot" id="status-tileserver"></span><span>TileServer (:8085)</span></div>
                    <div class="status-row"><span class="status-dot" id="status-cyberchef"></span><span>CyberChef (:8087)</span></div>
                    <div class="status-row"><span class="status-dot" id="status-trilium"></span><span>Trilium (:24/notes)</span></div>
                </div>
                <div style="margin-top: 20px;">
                    <a href="/monitor/" style="color: #4a8a4a; text-decoration: none; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px;">→ <span data-i18n="fullMonitor">РИТУАЛ МОНИТОРИНГА</span></a>
                </div>
            </div>
        </div>
        
                <!-- Сервисы (первый ряд) -->
        <div class="services-grid">
            <a href="http://192.168.1.46:8081/" class="service-card" target="_blank">
                <div class="service-icon">📜</div>
                <div class="service-name">Kanboard</div>
                <div class="service-port">:8081</div>
                <div class="service-note">admin / admin</div>
            </a>
            
            <a href="http://192.168.1.46:8082/" class="service-card" target="_blank">
                <div class="service-icon">🗄️</div>
                <div class="service-name">FileBrowser</div>
                <div class="service-port">:8082</div>
                <div class="service-note">admin / homelib2024</div>
            </a>
            
            <a href="http://192.168.1.46:8083/" class="service-card" target="_blank">
                <div class="service-icon">🔮</div>
                <div class="service-name">Calibre-Web</div>
                <div class="service-port">:8083</div>
                <div class="service-note">admin / admin123</div>
                <div class="formats">
                    <span class="format-tag">DJVU</span>
                    <span class="format-tag">FB2</span>
                    <span class="format-tag">EPUB</span>
                    <span class="format-tag">PDF</span>
                </div>
            </a>
            
            <a href="http://192.168.1.46:8084/" class="service-card" target="_blank">
                <div class="service-icon">🖥️</div>
                <div class="service-name">Kiwix</div>
                <div class="service-port">:8084</div>
                <div class="service-note">Wikipedia • WikiHow</div>
            </a>
        </div>
        
        <!-- Сервисы (второй ряд) -->
        <div class="services-grid">
            <a href="http://192.168.1.46:8085/" class="service-card" target="_blank">
                <div class="service-icon">🛰️</div>
                <div class="service-name">TileServer</div>
                <div class="service-port">:8085</div>
                <div class="service-note" data-i18n="offlineMaps">Карты Хаоса</div>
            </a>
            
            <a href="/notes/" class="service-card">
                <div class="service-icon">🔧</div>
                <div class="service-name">Trilium</div>
                <div class="service-port">:24/notes</div>
                <div class="service-note">admin / homelib2024</div>
            </a>
            
            <a href="http://192.168.1.46:8087/" class="service-card" target="_blank">
                <div class="service-icon">🧪</div>
                <div class="service-name">CyberChef</div>
                <div class="service-port">:8087</div>
                <div class="service-note">Base64 • Hex • JSON • AES</div>
                <div class="formats">
                    <span class="format-tag">300+ <span data-i18n="operations">ритуалов</span></span>
                    <span class="format-tag">AES</span>
                    <span class="format-tag">Base64</span>
                </div>
            </a>
            
            <a href="http://192.168.1.46:61208/" class="service-card" target="_blank">
                <div class="service-icon">👁️</div>
                <div class="service-name">Glances</div>
                <div class="service-port">:61208</div>
                <div class="service-note" data-i18n="sysMonitor">Сканер Варпа</div>
            </a>
        </div>
        
        <!-- Карта -->
        <div class="card map-card" id="map-card">
            <div class="map-header">
                <div class="card-title" style="margin-bottom: 0; border-bottom: none; padding-bottom: 0;">🗺️ <span data-i18n="northwestRegion">Северо-Западный сектор</span></div>
                <div style="display: flex; align-items: center; gap: 15px;">
                    <span style="background: #0a120a; color: #4a8a4a; padding: 6px 14px; border: 1px solid #2a4a2a; font-size: 0.8rem; font-family: 'Courier New', monospace;">:8085</span>
                                        <button id="toggle-map-btn" style="background: #0a120a; border: 1px solid #4a8a4a; color: #4a8a4a; padding: 6px 14px; font-family: 'Courier New', monospace; font-size: 0.8rem; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; transition: all 0.2s;">▲ <span data-i18n="hideMap">СВЕРНУТЬ</span></button>
                </div>
            </div>
            <div id="map-container" style="transition: height 0.3s ease; height: 400px; overflow: hidden;">
                <div id="map" class="map-container"></div>
            </div>
        </div>
        
        <div class="footer">
            <span data-i18n="footer">☠ Да пребудет с вами Хаос ☠ • Администратор: admin / homelib2024</span>
        </div>
    </div>
    
    <script>
        // ==================== ЛОКАЛИЗАЦИЯ ====================
        const translations = {
            ru: {
                title: 'СТАНДАРТНЫЕ ШАБЛОННЫЕ КОНСТРУКЦИИ',
                system: 'СИСТЕМА',
                os: 'ОС',
                uptime: 'АПТАЙМ',
                status: 'СТАТУС СЕРВИСОВ',
                fullMonitor: 'РИТУАЛ МОНИТОРИНГА',
                offlineMaps: 'Карты Хаоса',
                operations: 'ритуалов',
                sysMonitor: 'Сканер Варпа',
                northwestRegion: 'Северо-Западный сектор',
                footer: '☠ Смерть Лже-Императору ☠ • Администратор: admin / homelib2024',
                hideMap: '▲ СВЕРНУТЬ',
                showMap: '▼ РАЗВЕРНУТЬ'
            },
            en: {
                title: 'STANDARD TEMPLATE CONSTRUCT',
                system: 'SYSTEM',
                os: 'OS',
                uptime: 'UPTIME',
                status: 'SERVICE STATUS',
                fullMonitor: 'MONITORING RITUAL',
                offlineMaps: 'Chaos Maps',
                operations: 'rituals',
                sysMonitor: 'Warp Scanner',
                northwestRegion: 'Northwestern Sector',
                footer: '☠ Death to the False Emperor ☠ • Administrator: admin / homelib2024',
                hideMap: '▲ HIDE',
                showMap: '▼ SHOW'
            }
        };
        
        let currentLang = 'ru';
        
        function switchLanguage(lang) {
            currentLang = lang;
            
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.lang === lang);
            });
            
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.dataset.i18n;
                if (translations[lang] && translations[lang][key]) {
                    el.textContent = translations[lang][key];
                }
            });
            
            localStorage.setItem('homelab-lang', lang);
        }
        
        const savedLang = localStorage.getItem('homelab-lang') || 'ru';
        switchLanguage(savedLang);
        
        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', () => switchLanguage(btn.dataset.lang));
        });
        
        // ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ====================
        function formatBytes(bytes) {
            if (!bytes || bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }
        
        function formatUptime(seconds) {
            if (!seconds || seconds === 0) return '—';
            const days = Math.floor(seconds / 86400);
            const hours = Math.floor((seconds % 86400) / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            
            if (currentLang === 'ru') {
                if (days > 0) return `${days}д ${hours}ч`;
                if (hours > 0) return `${hours}ч ${minutes}м`;
                return `${minutes}м`;
            } else {
                if (days > 0) return `${days}d ${hours}h`;
                if (hours > 0) return `${hours}h ${minutes}m`;
                return `${minutes}m`;
            }
        }
        
        // ==================== СТАТУС СЕРВИСОВ ====================
        const SERVICES = [
            { id: 'nginx', url: 'http://192.168.1.46:24/' },
            { id: 'kanboard', url: 'http://192.168.1.46:8081/' },
            { id: 'filebrowser', url: 'http://192.168.1.46:8082/' },
            { id: 'calibre', url: 'http://192.168.1.46:8083/' },
            { id: 'kiwix', url: 'http://192.168.1.46:8084/' },
            { id: 'tileserver', url: 'http://192.168.1.46:8085/' },
            { id: 'cyberchef', url: 'http://192.168.1.46:8087/' },
            { id: 'trilium', url: 'http://192.168.1.46:24/notes/' }
        ];
        
        async function checkServiceStatus() {
            for (const svc of SERVICES) {
                try {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 3000);
                    await fetch(svc.url, { mode: 'no-cors', signal: controller.signal });
                    clearTimeout(timeoutId);
                    document.getElementById(`status-${svc.id}`).classList.remove('offline');
                } catch (e) {
                    document.getElementById(`status-${svc.id}`).classList.add('offline');
                }
            }
        }
        
        // ==================== МОНИТОРИНГ ====================
        async function fetchSystemData() {
            try {
                const cpuRes = await fetch('/api/glances/cpu');
                const cpuData = await cpuRes.json();
                const cpuUsage = cpuData.total?.toFixed(1) || '—';
                document.getElementById('cpu-usage').textContent = `${cpuUsage}%`;
                const cpuBar = document.getElementById('cpu-bar');
                cpuBar.style.width = `${cpuUsage}%`;
                cpuBar.classList.toggle('warning', cpuUsage > 70);
                cpuBar.classList.toggle('critical', cpuUsage > 90);
                
                const sysRes = await fetch('/api/glances/system');
                const sysData = await sysRes.json();
                document.getElementById('os-name').textContent = 
                    `${sysData.linux_distro || 'Linux'} ${sysData.platform_version || ''}`;
                
                const memRes = await fetch('/api/glances/mem');
                const memData = await memRes.json();
                const ramPercent = memData.percent || 0;
                document.getElementById('ram-usage').textContent = 
                    `${formatBytes(memData.used || 0)} / ${formatBytes(memData.total || 0)}`;
                const ramBar = document.getElementById('ram-bar');
                ramBar.style.width = `${ramPercent}%`;
                ramBar.classList.toggle('warning', ramPercent > 70);
                ramBar.classList.toggle('critical', ramPercent > 90);
                
                const loadRes = await fetch('/api/glances/load');
                const loadData = await loadRes.json();
                document.getElementById('load-avg').textContent = 
                    `${loadData.min1?.toFixed(2) || '—'} / ${loadData.min5?.toFixed(2) || '—'} / ${loadData.min15?.toFixed(2) || '—'}`;
                
                const uptimeRes = await fetch('/api/glances/uptime');
                const uptimeSec = await uptimeRes.text();
                document.getElementById('uptime').textContent = formatUptime(parseInt(uptimeSec) || 0);
                
                try {
                    const sensRes = await fetch('/api/glances/sensors');
                    const sensData = await sensRes.json();
                    const cpuTemp = sensData.find(s => 
                        s.label?.includes('Core') || s.label?.includes('Package') || s.type === 'temperature_core'
                    );
                    if (cpuTemp) document.getElementById('cpu-temp').textContent = `${cpuTemp.value}°C`;
                    const gpuTemp = sensData.find(s => 
                        s.label?.includes('GPU') || s.type === 'temperature_gpu'
                    );
                    if (gpuTemp) document.getElementById('gpu-temp').textContent = `${gpuTemp.value}°C`;
                } catch (e) {}
                
                // Хардкод CPU/GPU
                document.getElementById('cpu-model').textContent = 'Intel Core i5-2380P @ 3.10GHz';
                document.getElementById('cpu-cores').textContent = currentLang === 'ru' ? '4 ядра' : '4 cores';
                document.getElementById('gpu-name').textContent = 'NVIDIA GeForce GTX 1050 Ti';
                document.getElementById('gpu-mem').textContent = '4 GB';
                
                document.getElementById('update-time').textContent = 
                    new Date().toLocaleTimeString(currentLang === 'ru' ? 'ru-RU' : 'en-US', { hour: '2-digit', minute: '2-digit' });
                
            } catch (error) {
                console.error('Ошибка загрузки системных данных:', error);
            }
        }
        
        // ==================== ЗАПУСК ====================
        fetchSystemData();
        checkServiceStatus();
        setInterval(fetchSystemData, 5000);
        setInterval(checkServiceStatus, 30000);
        
        // ==================== ИНИЦИАЛИЗАЦИЯ КАРТЫ ====================
        function initMap() {
            if (typeof maplibregl === 'undefined') {
                document.getElementById('map').innerHTML = '<p style="color: #4a6a4a; text-align: center; padding-top: 150px;">Картографические данные недоступны</p>';
                return;
            }
            
            try {
                mapInstance = new maplibregl.Map({
                    container: 'map',
                    style: 'http://192.168.1.46:24/maps/styles/northwestern/style.json',
                    center: [30.3351, 59.9343],
                    zoom: 8,
                    minZoom: 2,
                    maxZoom: 14
                });
                mapInstance.addControl(new maplibregl.NavigationControl());
            } catch (e) {
                console.error('Ошибка карты:', e);
                document.getElementById('map').innerHTML = '<p style="color: #4a6a4a; text-align: center; padding-top: 150px;">Ошибка загрузки карты</p>';
            }
        }
        
        // ==================== СВОРАЧИВАНИЕ КАРТЫ ====================
        const toggleBtn = document.getElementById('toggle-map-btn');
        const mapContainer = document.getElementById('map-container');
        const mapCard = document.getElementById('map-card');
        let mapVisible = true;
        let mapInstance = null;

        function updateMapButton() {
            const hideText = translations[currentLang].hideMap;
            const showText = translations[currentLang].showMap;
            if (mapVisible) {
                toggleBtn.innerHTML = hideText;
            } else {
                toggleBtn.innerHTML = showText;
            }
        }

        // 🔑 Инициализация карты при загрузке
        function initializeMapIfNeeded() {
            if (mapVisible && !mapInstance && typeof maplibregl !== 'undefined') {
                initMap();
            }
        }

        toggleBtn.addEventListener('click', function() {
            if (mapVisible) {
                mapContainer.style.height = '0';
                mapCard.style.opacity = '0.7';
                mapVisible = false;
            } else {
                mapContainer.style.height = '400px';
                mapCard.style.opacity = '1';
                mapVisible = true;
                initializeMapIfNeeded();
            }
            updateMapButton();
        });

        // Обновить кнопку при смене языка
        const originalSwitchLanguage = switchLanguage;
        switchLanguage = function(lang) {
            originalSwitchLanguage(lang);
            updateMapButton();
        };

        // Инициализация кнопки
        updateMapButton();

        // 🔑 ЗАПУСК КАРТЫ ПРИ ЗАГРУЗКЕ (через небольшую задержку, чтобы DOM и библиотеки загрузились)
        setTimeout(function() {
            initializeMapIfNeeded();
        }, 500);
    </script>
</body>
</html>