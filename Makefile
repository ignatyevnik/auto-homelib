.PHONY: help install start stop restart logs status fix-perms clean test-network

help:
	@echo "HomeLab Management Commands"
	@echo "============================"
	@echo "make install       - ?????? ?????????"
	@echo "make start         - ????????? ???????"
	@echo "make stop          - ?????????? ???????"
	@echo "make restart       - ?????????????"
	@echo "make logs          - ???????? ????"
	@echo "make status        - ?????? ????????"
	@echo "make fix-perms     - ????????? ?????"
	@echo "make test-network  - ????????? ??????? ??????"
	@echo "make clean         - ???????"

install:
	@echo "?? ????????? HomeLab..."
	@chmod +x scripts/*.sh
	@./scripts/mount_hdd.sh
	@./scripts/fix_permissions.sh
	@docker compose up -d
	@echo ""
	@echo "? ????????? ?????????!"
	@echo "?? ??????: http://192.168.1.46:24"
	@echo ""
	@make test-network

start:
	@docker compose up -d
	@echo "? ??????? ????????"

stop:
	@docker compose down
	@echo "?? ??????? ???????????"

restart:
	@docker compose down
	@docker compose up -d
	@echo "?? ??????? ????????????"

logs:
	@docker compose logs -f --tail=50

status:
	@echo "?? ?????? ???????????:"
	@docker compose ps
	@echo ""
	@echo "?? ????????????? ??????:"
	@df -h | grep -E "Filesystem|/mnt/hdd"
	@echo ""
	@echo "?? ??????? ?????:"
	@sudo netstat -tlnp | grep :24 || echo "???? 24 ?? ??????????????"

fix-perms:
	@./scripts/fix_permissions.sh

test-network:
	@echo "?? ???????? ???????? ???????..."
	@echo -n "????????? ??????: "
	@curl -s -o /dev/null -w "%{http_code}" http://localhost:24 || echo "? ??????"
	@echo ""
	@echo -n "?????? ?? IP: "
	@curl -s -o /dev/null -w "%{http_code}" http://192.168.1.46:24 || echo "? ??????"
	@echo ""
	@echo "?? ???????? ????? 24:"
	@ss -tln | grep :24 || echo "?? ???? 24 ?? ??????"

clean:
	@echo "?? ???????..."
	@docker system prune -f
	@rm -rf /tmp/nginx-* 2>/dev/null || true
	@echo "? ??????? ?????????"